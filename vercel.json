{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/v2", "destination": "/", "permanent": true },
    { "source": "/v2/:path", "destination": "/:path", "permanent": true }
  ],
  "headers": [
    { "source": "/(a|b|c|card)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
